# ---- Everything is optional. Without keys the system runs in DEMO mode. ----
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Brain (LLM) - the account director + The Agency specialists
ANTHROPIC_API_KEY=
# On hosts that reserve ANTHROPIC_* names (e.g. Claude Code cloud environments) use this instead:
AGENCY_ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# Media generation
OPENAI_API_KEY=          # gpt-image banners (OpenAI retired the Sora video API on 2026-09-24)
FAL_KEY=                 # fal.ai: videos + image models
FAL_VIDEO_MODEL=bytedance/seedance-2.0/text-to-video   # any fal text-to-video model
FAL_VIDEO_RESOLUTION=720p
# Talking presenter videos: OpenAI TTS voice-over + lip-synced avatar on fal.ai
FAL_AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
OPENAI_TTS_MODEL=gpt-4o-mini-tts
UNSPLASH_ACCESS_KEY=     # stock photos for landing pages

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Social publishing / Meta ads (Facebook Graph API)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=      # act_XXXXXXXX

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Other networks
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=     # urn:li:organization:123 or urn:li:person:abc
TIKTOK_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Email login codes (optional - otherwise the code is shown on screen in demo mode)
RESEND_API_KEY=
EMAIL_FROM=
